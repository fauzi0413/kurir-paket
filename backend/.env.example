# Server Port
PORT=8080

# Environment mode (development / production)
ENVIRONMENT=production

# CORS Configuration (Gunakan * untuk development, atau domain spesifik di production)
# Contoh production: https://kurir-paket.vercel.app,https://yourdomain.com
CORS_ALLOWED_ORIGINS=*

# Optional: Layani frontend secara langsung dari Go Server (true / false)
SERVE_STATIC=false
