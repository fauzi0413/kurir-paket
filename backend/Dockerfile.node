# =========================================================================
# Production Dockerfile untuk Node.js Game Server
# =========================================================================

FROM node:18-alpine

WORKDIR /app

# Salin konfigurasi package
COPY package.json ./

# Salin kode server
COPY server.js ./

# Set environment
ENV NODE_ENV=production
ENV PORT=8080

EXPOSE 8080

# Health check
HEALTHCHECK --interval=30s --timeout=5s --start-period=5s --retries=3 \
  CMD wget --no-verbose --tries=1 --spider http://localhost:8080/health || exit 1

CMD ["node", "server.js"]
