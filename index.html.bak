        ],
        houses: [
          { id: 201, x: -54, z: -15, dropX: -48, dropZ: -4,  color: 0xec4899 },
          { id: 202, x: 15,  z: -59, dropX: 15,  dropZ: -48, color: 0x06b6d4 },
          { id: 203, x: 59,  z: -12, dropX: 48,  dropZ: -12, color: 0x8b5cf6 },
          { id: 204, x: 52,  z: 49,  dropX: 52,  dropZ: 38,  color: 0xf97316 },
          { id: 205, x: -18, z: 61,  dropX: -18, dropZ: 50,  color: 0x14b8a6 },
