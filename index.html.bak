          { type: 'concrete', minX: 40,  maxX: 48,  minZ: -44, maxZ: 30 },
          // Jalan Tanah (Dirt Trail) Kompleks Barat Daya
          { type: 'dirt', minX: -46, maxX: -38, minZ: 4,  maxZ: 50 },
