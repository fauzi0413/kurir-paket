<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
  <title>Warehouse Express 3D: Connected City</title>
  <!-- Tailwind CSS CDN -->
  <script src="https://cdn.tailwindcss.com"></script>
  <!-- Three.js CDN -->
  <script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js"></script>
  <!-- Font Awesome Icons -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

  <style>
    * {
      box-sizing: border-box;
      user-select: none;
      -webkit-user-select: none;
      margin: 0;
      padding: 0;
    }
    body {
      background-color: #090d16;
      color: #f1f5f9;
      font-family: 'Inter', system-ui, -apple-system, sans-serif;
      overflow: hidden;
      width: 100vw;
      height: 100vh;
    }
    canvas {
      display: block;
      width: 100vw;
      height: 100vh;
      outline: none;
    }
    .glass-card {
      background: rgba(15, 23, 42, 0.88);
      backdrop-filter: blur(12px);
      -webkit-backdrop-filter: blur(12px);
      border: 1px solid rgba(255, 255, 255, 0.14);
      box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.55);
    }
    .neon-amber {
      text-shadow: 0 0 10px rgba(245, 158, 11, 0.5);
    }
    .progress-ring-circle {
      transition: stroke-dashoffset 0.06s linear;
      transform: rotate(-90deg);
      transform-origin: 50% 50%;
    }
    .level-pill {
      background: linear-gradient(135deg, #0284c7, #2563eb);
    }
  </style>
</head>
<body class="relative w-screen h-screen overflow-hidden text-slate-100">

  <!-- 3D Viewport Container -->
  <div id="game-canvas-container" class="absolute inset-0 z-0"></div>

  <!-- HUD: Top Bar & Game Objectives (Rapi, tidak menutupi tengah layar) -->
  <header class="absolute top-0 left-0 right-0 z-20 flex flex-wrap items-start justify-between p-3 md:p-5 pointer-events-none gap-3">
    <!-- Left: Level Badge, Shift Timer, Quota Target -->
    <div class="pointer-events-auto flex items-center gap-2.5 flex-wrap">
      <!-- Current Level Badge -->
      <div class="glass-card px-3.5 py-2 rounded-2xl flex items-center gap-2.5 border-cyan-400/40">
        <div class="level-pill w-8 h-8 rounded-xl flex items-center justify-center font-black text-white text-xs shadow-md">
          <span id="hud-level-number">L1</span>
        </div>
        <div>
          <span class="text-[9px] uppercase font-bold text-slate-400 block tracking-wider leading-none">Distrik Kota</span>
          <span id="hud-level-title" class="text-xs font-extrabold text-cyan-300">Suburban</span>
        </div>
      </div>

      <!-- Countdown Shift Timer -->
      <div class="glass-card px-3.5 py-2 rounded-2xl flex items-center gap-2.5 border-amber-500/40">
        <div class="w-8 h-8 rounded-xl bg-amber-500/20 border border-amber-500/50 flex items-center justify-center text-amber-400">
          <i class="fa-solid fa-stopwatch text-sm animate-pulse"></i>
        </div>
        <div>
          <span class="text-[9px] uppercase font-bold text-slate-400 block tracking-wider leading-none">Sisa Waktu Shift</span>
          <span id="shift-timer" class="text-base md:text-lg font-black text-amber-400 neon-amber tracking-tight font-mono">02:15</span>
        </div>
      </div>

      <!-- Quota Target -->
      <div class="glass-card px-3.5 py-2 rounded-2xl flex items-center gap-2.5 border-cyan-500/40">
        <div class="w-8 h-8 rounded-xl bg-cyan-500/20 border border-cyan-500/50 flex items-center justify-center text-cyan-400">
          <i class="fa-solid fa-boxes-packing text-sm"></i>
        </div>
        <div>
          <span class="text-[9px] uppercase font-bold text-slate-400 block tracking-wider leading-none">Kuota Kirim</span>
          <span class="text-base md:text-lg font-black text-cyan-300 font-mono">
            <span id="quota-delivered">0</span><span class="text-xs text-slate-400 font-normal"> / </span><span id="quota-target">4</span>
          </span>
        </div>
      </div>

      <!-- Cargo Stack Loaded -->
      <div class="glass-card px-3.5 py-2 rounded-2xl flex items-center gap-2.5 border-orange-500/40">
        <div class="w-8 h-8 rounded-xl bg-orange-500/20 border border-orange-500/50 flex items-center justify-center text-orange-400">
          <i class="fa-solid fa-dolly text-sm"></i>
        </div>
        <div>
          <span class="text-[9px] uppercase font-bold text-slate-400 block tracking-wider leading-none">Muatan Mobil</span>
          <span id="hud-cargo" class="text-base md:text-lg font-black text-orange-400 font-mono">0 / 3</span>
        </div>
      </div>
    </div>

    <!-- Center: Compact Floating Objective Pill -->
    <div class="pointer-events-auto order-3 xl:order-2 w-full xl:w-auto flex justify-center mt-1 xl:mt-0">
      <div id="objective-banner" class="glass-card w-fit max-w-[92vw] px-5 py-2 rounded-full border-cyan-400/50 flex items-center gap-2.5 shadow-lg">
        <span class="w-2.5 h-2.5 rounded-full bg-cyan-400 animate-ping shrink-0"></span>
        <span id="objective-text" class="text-xs md:text-sm font-semibold text-slate-100 truncate">
          📦 Menuju Lingkaran Kuning Gudang untuk memuat 3 paket!
        </span>
      </div>
    </div>

    <!-- Right: Total Salary & Go Architecture Modal Trigger -->
    <div class="pointer-events-auto order-2 xl:order-3 flex items-center gap-2.5">
      <div class="glass-card px-3.5 py-2 rounded-2xl flex items-center gap-2.5 border-emerald-500/40">
        <div class="w-8 h-8 rounded-xl bg-emerald-500/20 border border-emerald-500/50 flex items-center justify-center text-emerald-400 font-bold text-xs">
          Rp
        </div>
        <div class="text-right">
          <span class="text-[9px] uppercase font-bold text-slate-400 block leading-none">Gaji Terkumpul</span>
          <span id="hud-cash" class="text-base md:text-lg font-black text-emerald-400 font-mono">0</span>
        </div>
      </div>

      <button id="btn-open-go" class="px-3.5 py-2 h-12 rounded-2xl glass-card bg-cyan-950/60 border-cyan-500/50 hover:border-cyan-400 text-cyan-300 text-xs font-bold flex items-center gap-2 active:scale-95 transition-all cursor-pointer">
        <i class="fa-brands fa-golang text-xl text-cyan-400"></i>
        <span class="hidden sm:inline">Go Backend Logic</span>
      </button>
    </div>
  </header>

  <!-- Toast Notification Pill (Muncul di bawah Top Bar saat sukses) -->
  <div id="toast-pill" class="absolute top-28 left-1/2 -translate-x-1/2 z-30 pointer-events-none transition-all duration-300 opacity-0 transform -translate-y-3 scale-95">
    <div class="glass-card w-fit px-5 py-2 rounded-full border-emerald-400/60 text-emerald-300 text-xs md:text-sm font-bold shadow-xl flex items-center gap-2">
      <i class="fa-solid fa-circle-check text-emerald-400"></i>
      <span id="toast-text">Pengantaran Berhasil!</span>
    </div>
  </div>

  <!-- Interactive Action & Progress Floating Overlay (Muncul saat mobil masuk ke zona Gudang / Rumah) -->
  <div id="interaction-overlay" class="absolute bottom-24 left-1/2 -translate-x-1/2 z-30 pointer-events-none transition-all duration-200 opacity-0 transform translate-y-4 scale-95">
    <div class="glass-card p-3 pr-5 rounded-2xl border-cyan-400/70 shadow-2xl flex items-center gap-3.5 bg-slate-900/95 pointer-events-auto cursor-pointer" id="interaction-card-btn">
      <div class="relative w-12 h-12 flex items-center justify-center shrink-0">
        <svg class="w-12 h-12" viewBox="0 0 56 56">
          <circle class="text-slate-700" stroke-width="4" stroke="currentColor" fill="transparent" r="22" cx="28" cy="28"/>
          <circle id="progress-circle" class="progress-ring-circle text-cyan-400" stroke-dasharray="138.23" stroke-dashoffset="138.23" stroke-width="4" stroke-linecap="round" stroke="currentColor" fill="transparent" r="22" cx="28" cy="28"/>
        </svg>
        <div id="progress-action-icon" class="absolute inset-0 flex items-center justify-center text-cyan-400 text-base">
          <i class="fa-solid fa-barcode"></i>
        </div>
      </div>

      <div>
        <div class="flex items-center gap-2">
          <span id="action-badge" class="px-2 py-0.5 rounded bg-cyan-500/20 text-cyan-300 text-[10px] font-bold uppercase tracking-wider">Zona Aktif</span>
          <span id="action-subtext" class="text-xs font-bold text-white">Verifikasi Manifest Paket</span>
        </div>
        <p class="text-[11px] text-slate-300 mt-0.5">
          Tahan <span class="px-1.5 py-0.5 rounded bg-slate-800 text-cyan-300 border border-slate-700 font-mono text-[10px] font-bold">SPASI</span> atau Tahan Tombol Ini
        </p>
      </div>
    </div>
  </div>

  <!-- Bottom HUD Layer: Surface Speed Indicator (Kiri) & Controls/Action (Kanan) -->
  <div class="absolute bottom-5 left-5 right-5 z-20 flex justify-between items-end pointer-events-none">
    <!-- Left: Surface Speed Badge & Keyboard Hint -->
    <div class="flex flex-col gap-2 items-start">
      <div class="glass-card w-fit px-3.5 py-2 rounded-2xl flex items-center gap-3 pointer-events-auto">
        <div id="surface-icon-box" class="w-8 h-8 rounded-xl bg-slate-800 flex items-center justify-center text-cyan-400 transition-colors">
          <i id="surface-icon" class="fa-solid fa-road text-xs"></i>
        </div>
        <div>
          <span class="text-[9px] uppercase font-bold text-slate-400 block leading-none">Permukaan Jalan</span>
          <span id="surface-label" class="text-xs font-black text-cyan-400">JALAN ASPAL (100% SPEED)</span>
        </div>
      </div>

      <div class="glass-card w-fit px-3.5 py-1.5 rounded-xl text-[11px] text-slate-300 hidden md:flex items-center gap-2 pointer-events-auto">
        <span>🕹️ Kemudi: <b class="text-cyan-300">W A S D</b> / <b class="text-cyan-300">Panah</b></span>
        <span class="text-slate-600">|</span>
        <span>📦 Verifikasi: Tahan <b class="text-amber-300">SPASI</b> di Lingkaran</span>
      </div>

      <!-- Mobile Virtual Joystick -->
      <div id="joystick-zone" class="w-28 h-28 rounded-full border-2 border-dashed border-white/25 bg-slate-900/50 backdrop-blur-md relative pointer-events-auto touch-none md:hidden">
        <div id="joystick-knob" class="w-11 h-11 rounded-full bg-cyan-500/90 shadow-lg absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2"></div>
      </div>
    </div>

    <!-- Right: Always-accessible Hold Verification Button -->
    <button id="hold-verify-btn" class="w-16 h-16 md:w-20 md:h-20 rounded-2xl glass-card bg-slate-900/90 border-cyan-500/50 hover:border-cyan-400 active:scale-95 text-white font-black text-[10px] flex flex-col items-center justify-center gap-1 pointer-events-auto shadow-2xl transition-all cursor-pointer touch-none">
      <i class="fa-solid fa-fingerprint text-xl md:text-2xl text-cyan-400"></i>
      <span id="hold-btn-label" class="tracking-wider">TAHAN</span>
    </button>
  </div>

  <!-- START / LEVEL TRANSITION / GAME OVER MODAL -->
  <div id="modal-screen" class="fixed inset-0 z-40 flex items-center justify-center p-4 bg-black/80 backdrop-blur-md">
    <div class="glass-card w-full max-w-lg rounded-3xl p-6 md:p-8 text-center relative border-cyan-500/40 shadow-2xl overflow-hidden">
      <div class="w-16 h-16 rounded-2xl bg-gradient-to-tr from-cyan-600 to-indigo-600 mx-auto flex items-center justify-center text-white text-2xl shadow-xl shadow-cyan-500/30 mb-4">
        <i id="modal-header-icon" class="fa-solid fa-truck-fast"></i>
      </div>

      <h1 id="modal-title" class="text-2xl md:text-3xl font-black text-white tracking-tight mb-1">WAREHOUSE EXPRESS 3D</h1>
      <p id="modal-subtitle" class="text-slate-300 text-xs md:text-sm mb-6">
        Antarkan paket dari Gudang ke warga di pinggir jalan! Patuhi jalur Aspal (100%), Beton (80%), dan Tanah (60%).
      </p>

      <!-- Stats Grid Result -->
      <div class="grid grid-cols-2 gap-3 mb-6 text-left">
        <div class="p-3 rounded-2xl bg-slate-900/80 border border-slate-800">
          <span class="text-[10px] uppercase font-bold text-slate-400 block">Distrik Aktif</span>
          <span id="stat-level-text" class="text-lg font-black text-cyan-400 font-mono">Level 1</span>
          <span id="stat-quota-badge" class="text-[11px] text-emerald-400 block font-semibold">Target: 4 Paket</span>
        </div>
        <div class="p-3 rounded-2xl bg-slate-900/80 border border-slate-800">
          <span class="text-[10px] uppercase font-bold text-slate-400 block">Jaringan Rute</span>
          <span id="stat-theme" class="text-sm font-black text-cyan-300 font-mono">ASPAL & TANAH</span>
          <span class="text-[11px] text-slate-400 block">100% Jalan Terhubung</span>
        </div>
        <div class="p-3 rounded-2xl bg-slate-900/80 border border-slate-800">
          <span class="text-[10px] uppercase font-bold text-slate-400 block">Total Gaji Kurir</span>
          <span id="stat-salary" class="text-lg font-black text-emerald-400 font-mono">Rp 0</span>
        </div>
        <div class="p-3 rounded-2xl bg-slate-900/80 border border-slate-800">
          <span class="text-[10px] uppercase font-bold text-slate-400 block">Rating Layanan</span>
          <div class="flex items-center gap-1.5 mt-0.5">
            <span id="stat-rating" class="text-lg font-black text-amber-400 font-mono">5.0</span>
            <div class="text-amber-400 text-xs flex gap-0.5">
              <i class="fa-solid fa-star"></i><i class="fa-solid fa-star"></i><i class="fa-solid fa-star"></i><i class="fa-solid fa-star"></i><i class="fa-solid fa-star"></i>
            </div>
          </div>
        </div>
      </div>

      <!-- Action Button -->
      <button id="btn-start-game" class="w-full py-4 rounded-2xl bg-gradient-to-r from-cyan-500 via-blue-600 to-emerald-500 text-white font-extrabold text-sm md:text-base tracking-wide shadow-xl hover:brightness-110 active:scale-[0.98] transition-all flex items-center justify-center gap-3 cursor-pointer">
        <i class="fa-solid fa-play"></i>
        <span id="btn-start-label">MULAI SHIFT LEVEL 1</span>
      </button>
    </div>
  </div>

  <!-- GO BACKEND ARCHITECTURE EXPLAINER MODAL -->
  <div id="go-modal" class="fixed inset-0 z-50 hidden flex items-center justify-center p-3 sm:p-6 bg-black/80 backdrop-blur-lg">
    <div class="glass-card w-full max-w-3xl max-h-[88vh] rounded-3xl p-5 md:p-7 flex flex-col relative border-cyan-500/40 overflow-hidden shadow-2xl">
      <div class="flex items-center justify-between pb-4 border-b border-slate-800">
        <div class="flex items-center gap-3">
          <div class="w-10 h-10 rounded-xl bg-cyan-500/20 border border-cyan-400/50 flex items-center justify-center text-cyan-400 text-2xl">
            <i class="fa-brands fa-golang"></i>
          </div>
          <div>
            <h2 class="text-base sm:text-lg font-bold text-white">
              Go Game Server: Spatial Road Graph & Anti-Duplicate Dispatcher
            </h2>
            <p class="text-xs text-slate-400">Arsitektur backend Golang untuk portofolio game kurir 3D</p>
          </div>
        </div>
        <button id="btn-close-go" class="w-9 h-9 rounded-xl glass-card hover:bg-slate-800 flex items-center justify-center text-slate-400 hover:text-white cursor-pointer">
          <i class="fa-solid fa-xmark"></i>
        </button>
      </div>

      <div class="flex-1 overflow-y-auto pr-1 text-slate-300 text-xs sm:text-sm space-y-4 my-4">
        <div>
          <h3 class="text-cyan-300 font-bold mb-1">1. Surface Speed Multiplier & Anti-Cheat (Go)</h3>
          <pre class="p-3.5 rounded-xl bg-slate-950 border border-slate-800 text-[11px] font-mono text-cyan-400 overflow-x-auto leading-relaxed">package game

type SurfaceType string

const (
    SurfaceAsphalt  SurfaceType = "asphalt"  // 100% Speed (0.56)
    SurfaceConcrete SurfaceType = "concrete" // 80% Speed  (0.45)
    SurfaceDirt     SurfaceType = "dirt"     // 60% Speed  (0.34)
    SurfaceGrass    SurfaceType = "grass"    // 35% Speed  (0.20)
)

func ValidatePlayerStep(p *Courier, nextX, nextZ, dt float64, surf SurfaceType) bool {
    dist := math.Hypot(nextX-p.X, nextZ-p.Z)
    maxAllowed := GetSurfaceMaxSpeed(surf) * (dt / 16.67) * 1.15
    return dist <= maxAllowed
}</pre>
        </div>

        <div>
          <h3 class="text-cyan-300 font-bold mb-1">2. Mutex-Safe Random Order Dispatcher (Tanpa Duplikasi Beruntun)</h3>
          <pre class="p-3.5 rounded-xl bg-slate-950 border border-slate-800 text-[11px] font-mono text-emerald-400 overflow-x-auto leading-relaxed">func (d *Dispatcher) NextTargetHouse(houses []int) int {
    d.mu.Lock()
    defer d.mu.Unlock()

    candidates := make([]int, 0, len(houses))
    for _, id := range houses {
        if id != d.lastDeliveredHouseID {
            candidates = append(candidates, id)
        }
    }
    picked := candidates[rand.Intn(len(candidates))]
    d.lastDeliveredHouseID = picked
    return picked
}</pre>
        </div>
      </div>
    </div>
  </div>

  <!-- MAIN GAME SCRIPT -->
  <script>
    /* =========================================================================
       1. WEB AUDIO SYNTHESIZER (HALUS & BEBAS CONSOLE ERROR)
       ========================================================================= */
    class SoundEngine {
      constructor() {
        this.ctx = null;
        this.osc1 = null;
        this.osc2 = null;
        this.filter = null;
        this.gain = null;
        this.ready = false;
      }

      init() {
        if (this.ready) {
          if (this.ctx && this.ctx.state === 'suspended') {
            this.ctx.resume().catch(() => {});
          }
          return;
        }
        try {
          const AudioCtx = window.AudioContext || window.webkitAudioContext;
          this.ctx = new AudioCtx();
          const now = this.ctx.currentTime;

          this.osc1 = this.ctx.createOscillator();
          this.osc2 = this.ctx.createOscillator();
          this.filter = this.ctx.createBiquadFilter();
          this.gain = this.ctx.createGain();

          this.osc1.type = 'triangle';
          this.osc2.type = 'sine';
          this.osc1.frequency.setValueAtTime(40, now);
          this.osc2.frequency.setValueAtTime(80, now);

          this.filter.type = 'lowpass';
          this.filter.frequency.setValueAtTime(130, now);

          this.gain.gain.setValueAtTime(0.001, now);

          this.osc1.connect(this.filter);
          this.osc2.connect(this.filter);
          this.filter.connect(this.gain);
          this.gain.connect(this.ctx.destination);

          this.osc1.start(now);
          this.osc2.start(now);
          this.ready = true;
        } catch (err) {
          // Abaikan bila browser menahan autoplay
        }
      }

      updateEngine(speedRatio) {
        if (!this.ready || !this.ctx) return;
        const now = this.ctx.currentTime;
        const baseFreq = 38 + speedRatio * 62;
        const targetGain = speedRatio > 0.04 ? 0.018 + speedRatio * 0.04 : 0.006;

        this.osc1.frequency.setTargetAtTime(baseFreq, now, 0.06);
        this.osc2.frequency.setTargetAtTime(baseFreq * 2, now, 0.06);
        this.filter.frequency.setTargetAtTime(120 + speedRatio * 240, now, 0.06);
        this.gain.gain.setTargetAtTime(targetGain, now, 0.06);
      }

      playBeep(freq, duration = 0.06, type = 'sine', vol = 0.08) {
        if (!this.ready || !this.ctx) return;
        try {
          const now = this.ctx.currentTime;
          const osc = this.ctx.createOscillator();
          const g = this.ctx.createGain();
          osc.type = type;
          osc.frequency.setValueAtTime(freq, now);
          g.gain.setValueAtTime(vol, now);
          g.gain.exponentialRampToValueAtTime(0.001, now + duration);
          osc.connect(g);
          g.connect(this.ctx.destination);
          osc.start(now);
          osc.stop(now + duration + 0.01);
        } catch (e) {}
      }

      playSuccess() {
        this.init();
        [523.25, 659.25, 783.99, 1046.5].forEach((f, i) => {
          setTimeout(() => this.playBeep(f, 0.16, 'triangle', 0.14), i * 65);
        });
      }
    }

    const sound = new SoundEngine();

    /* =========================================================================
       2. KONFIGURASI 3 LEVEL KOTA NON-KOTAK (ASYMMETRIC CITY BRANCHES)
       ========================================================================= */
    // Gudang berdiri di (x: 0, z: -22), Loading Bay di (x: 0, z: -10).
    // Posisi Spawn Mobil di (x: 0, z: -2) dengan Safe-Zone ketat agar bebas dari obstacle!
    const SPAWN_POS = { x: 0, z: -2 };

    const LEVEL_DATA = {
      1: {
        id: 1,
        title: "Suburban",
        fullName: "Lembah Suburban (Asymmetric Valley)",
        groundColor: 0x55962c,
        skyColor: 0xc8e6f5,
        quotaTarget: 4,
        shiftDuration: 140,
        themeDesc: "ASPAL, BETON & TANAH",
        roads: [
          // Driveway Gudang ke Jalan Utama
          { type: 'concrete', minX: -5, maxX: 5, minZ: -16, maxZ: -4 },
          // Jalan Raya Utama Timur-Barat (Aspal)
          { type: 'asphalt', minX: -56, maxX: 44, minZ: -4, maxZ: 4 },
          // Cabang Jalan Raya Barat mengarah ke Selatan (T-Junction Barat)
          { type: 'asphalt', minX: -48, maxX: -40, minZ: -4, maxZ: 48 },
          // Cabang Jalan Beton Timur mengarah ke Utara & Timur (L-Avenue)
          { type: 'concrete', minX: 28, maxX: 36, minZ: -48, maxZ: 4 },
          { type: 'concrete', minX: -14, maxX: 36, minZ: -48, maxZ: -40 },
          // Cabang Jalan Beton Tenggara
          { type: 'concrete', minX: 12, maxX: 20, minZ: 4, maxZ: 44 },
          { type: 'concrete', minX: 12, maxX: 52, minZ: 36, maxZ: 44 },
          // Jalur Tanah (Dirt Trail) Menuju Vila Barat Laut & Taman Selatan
          { type: 'dirt', minX: -36, maxX: -28, minZ: -46, maxZ: -4 },
          { type: 'dirt', minX: -40, maxX: 12, minZ: 26, maxZ: 34 }
        ],
        houses: [
          { id: 101, x: -43, z: -38, dropX: -32, dropZ: -38, color: 0xef4444 },
          { id: 102, x: -6,  z: -55, dropX: -6,  dropZ: -44, color: 0x3b82f6 },
          { id: 103, x: 47,  z: -24, dropX: 36,  dropZ: -24, color: 0x10b981 },
          { id: 104, x: -59, z: 36,  dropX: -48, dropZ: 36,  color: 0xf59e0b },
          { id: 105, x: 44,  z: 55,  dropX: 44,  dropZ: 44,  color: 0x8b5cf6 }
        ],
        // Barikade hanya ditempatkan di ujung jalan buntu sebagai batas kota yang logis
        barriers: [
