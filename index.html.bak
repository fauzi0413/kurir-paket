          { x: 61,  z: 34, width: 8, rot: Math.PI / 2 }
        ],
        cones: [
          { x: 10.5, z: 12 }, { x: 10.5, z: 16 },
          { x: -20,  z: -24 }, { x: -20, z: -28 }
        ]
      },
      3: {
        id: 3,
        title: "Pelabuhan",
        fullName: "Pelabuhan Industri (Harbor Piers)",
        groundColor: 0x475569,
        skyColor: 0xcbd5e1,
        quotaTarget: 8,
        shiftDuration: 175,
        themeDesc: "DERMAGA & KARGO",
        roads: [
          // Driveway Gudang
          { type: 'concrete', minX: -5, maxX: 5, minZ: -16, maxZ: -4 },
          // Spine Utama Pelabuhan (Aspal)
          { type: 'asphalt', minX: -62, maxX: 62, minZ: -4, maxZ: 4 },
          { type: 'asphalt', minX: -36, maxX: -28, minZ: -54, maxZ: 54 },
          // Dermaga Beton (Piers) Menjorok ke Timur & Selatan
          { type: 'concrete', minX: 28,  maxX: 36, minZ: -54, maxZ: 4 },
          { type: 'concrete', minX: -36, maxX: 56, minZ: 44,  maxZ: 52 },
          { type: 'concrete', minX: 48,  maxX: 56, minZ: -4,  maxZ: 52 },
          // Jalur Tanah Logistik Kontainer
          { type: 'dirt', minX: -62, maxX: -28, minZ: -48, maxZ: -40 },
          { type: 'dirt', minX: -4,  maxX: 4,   minZ: 4,   maxZ: 44 },
          { type: 'dirt', minX: 28,  maxX: 62,  minZ: -44, maxZ: -36 }
        ],
        houses: [
          { id: 301, x: -54, z: -59, dropX: -54, dropZ: -48, color: 0x38bdf8 },
          { id: 302, x: -47, z: 24,  dropX: -36, dropZ: 24,  color: 0xfacc15 },
          { id: 303, x: -54, z: -15, dropX: -54, dropZ: -4,  color: 0xa855f7 },
          { id: 304, x: 52,  z: -55, dropX: 52,  dropZ: -44, color: 0x4ade80 },
          { id: 305, x: 17,  z: -32, dropX: 28,  dropZ: -32, color: 0xf43f5e },
          { id: 306, x: 67,  z: 22,  dropX: 56,  dropZ: 22,  color: 0x0ea5e9 },
          { id: 307, x: 22,  z: 63,  dropX: 22,  dropZ: 52,  color: 0xfb923c },
          { id: 308, x: -16, z: 63,  dropX: -16, dropZ: 52,  color: 0xa3e635 }
        ],
        barriers: [
          { x: -63, z: 0,   width: 8, rot: Math.PI / 2 },
          { x: 63,  z: 0,   width: 8, rot: Math.PI / 2 },
          { x: -32, z: -55, width: 8, rot: 0 },
          { x: 32,  z: -55, width: 8, rot: 0 }
        ],
        cones: [
          { x: -20, z: 3.3 }, { x: -16, z: 3.3 },
          { x: 16,  z: -3.3 }, { x: 20, z: -3.3 }
        ]
      }
    };

    // Gudang berdiri di luar jalan raya (di x: 0, z: -22)
    const warehouseBuildingPos = new THREE.Vector3(0, 0, -22);
    // Lingkaran kuning Loading Bay berada di atas driveway beton (x: 0, z: -10)
    const warehouseBayPos = new THREE.Vector3(0, 0, -10);

    /* =========================================================================
       3. KONFIGURASI PERMUKAAN JALAN, STATE GAME & INISIALISASI THREE.JS
       ========================================================================= */
    const SURFACE_TYPES = {
      asphalt: {
        maxSpeed: 0.56,
        label: 'JALAN ASPAL (100% SPEED)',
        colorClass: 'text-cyan-400',
        icon: 'fa-road',
        boxClass: 'bg-slate-800 text-cyan-400'
      },
      concrete: {
        maxSpeed: 0.45,
        label: 'JALAN BETON (80% SPEED)',
        colorClass: 'text-sky-300',
        icon: 'fa-grip-lines',
        boxClass: 'bg-slate-800 text-sky-300'
      },
      dirt: {
        maxSpeed: 0.34,
        label: 'JALAN TANAH (60% SPEED)',
        colorClass: 'text-amber-400',
        icon: 'fa-mound',
        boxClass: 'bg-amber-950/60 text-amber-400'
      },
      offroad: {
        maxSpeed: 0.20,
        label: 'RUMPUT OFF-ROAD (35% SPEED)',
        colorClass: 'text-rose-400',
        icon: 'fa-triangle-exclamation',
        boxClass: 'bg-rose-950/70 text-rose-400'
      }
    };

    const state = {
      level: 1,
      isPlaying: false,
      timeLeft: 140,
      quotaTarget: 4,
      deliveredCount: 0,
      packagesLoaded: 0,
      maxPackages: 3,
      totalCash: 0,
      objective: 'warehouse', // 'warehouse' | 'house'
      targetHouse: null,
      lastDeliveredHouseId: null,
      speed: 0,
      courierRot: Math.PI,
      isHoldingVerify: false,
      verifyProgress: 0,
      lastBeepTime: 0
    };

    const keys = { w: false, a: false, s: false, d: false };
    let joyVec = { x: 0, y: 0 };

    let colliders = [];
    let roadSegments = [];
    let houses = [];
    let npcs = [];

    // Setup Scene, Camera Orthographic Isometrik & Renderer
    const container = document.getElementById('game-canvas-container');
    const scene = new THREE.Scene();
    scene.background = new THREE.Color(0xc8e6f5);
    scene.fog = new THREE.FogExp2(0xc8e6f5, 0.0065);

    const viewSize = 34;
    const aspect = window.innerWidth / window.innerHeight;
    const camera = new THREE.OrthographicCamera(
      -viewSize * aspect,
      viewSize * aspect,
      viewSize,
      -viewSize,
      1,
      1000
    );
    camera.position.set(46, 52, 46);
    camera.lookAt(0, 0, 0);

    const renderer = new THREE.WebGLRenderer({ antialias: true, powerPreference: 'high-performance' });
    renderer.setSize(window.innerWidth, window.innerHeight);
    renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
    renderer.shadowMap.enabled = true;
    renderer.shadowMap.type = THREE.PCFSoftShadowMap;
    container.appendChild(renderer.domElement);

    // Pencahayaan Matahari Hangat & Ambient
    const ambientLight = new THREE.AmbientLight(0xffffff, 0.72);
    scene.add(ambientLight);

    const dirLight = new THREE.DirectionalLight(0xfffbeb, 0.92);
    dirLight.position.set(65, 95, 45);
    dirLight.castShadow = true;
    dirLight.shadow.mapSize.width = 2048;
    dirLight.shadow.mapSize.height = 2048;
    const sBounds = 85;
    dirLight.shadow.camera.left = -sBounds;
    dirLight.shadow.camera.right = sBounds;
    dirLight.shadow.camera.top = sBounds;
    dirLight.shadow.camera.bottom = -sBounds;
    dirLight.shadow.camera.near = 1;
    dirLight.shadow.camera.far = 260;
    dirLight.shadow.bias = -0.0005;
    scene.add(dirLight);

    const worldGroup = new THREE.Group();
    scene.add(worldGroup);

    // Beacon Cahaya Langit di atas Tujuan Aktif agar selalu terlihat dari kejauhan
    const beaconGroup = new THREE.Group();
    const beaconBeam = new THREE.Mesh(
      new THREE.CylinderGeometry(1.8, 1.8, 32, 20, 1, true),
      new THREE.MeshBasicMaterial({
        color: 0xfacc15,
        transparent: true,
        opacity: 0.28,
        side: THREE.DoubleSide,
        depthWrite: false
      })
    );
    beaconBeam.position.y = 16;
    beaconGroup.add(beaconBeam);

    const beaconDiamond = new THREE.Mesh(
      new THREE.OctahedronGeometry(1.5, 0),
      new THREE.MeshBasicMaterial({ color: 0xfef08a })
    );
    beaconDiamond.position.y = 6.5;
    beaconGroup.add(beaconDiamond);
    scene.add(beaconGroup);

    function addBoxCollider(x, z, w, d) {
      colliders.push({
        type: 'box',
        minX: x - w / 2,
        maxX: x + w / 2,
        minZ: z - d / 2,
        maxZ: z + d / 2
      });
    }

    function addCircleCollider(x, z, r) {
      colliders.push({ type: 'circle', x, z, r });
    }

    // Validasi apakah titik (x, z) aman untuk menaruh pohon/batu/rintangan
    function isSafePropPosition(x, z, cfg, minMargin = 3.2) {
      // 1. Jangan pernah menaruh objek di dekat titik Spawn Mobil atau Loading Bay Gudang!
      if (Math.hypot(x - SPAWN_POS.x, z - SPAWN_POS.z) < 13) return false;
      if (Math.hypot(x - warehouseBayPos.x, z - warehouseBayPos.z) < 12) return false;
      if (Math.hypot(x - warehouseBuildingPos.x, z - warehouseBuildingPos.z) < 15) return false;

      // 2. Jangan menaruh objek di atas jalan raya (Aspal, Beton, Tanah)
      for (const r of cfg.roads) {
        if (
          x >= r.minX - minMargin && x <= r.maxX + minMargin &&
          z >= r.minZ - minMargin && z <= r.maxZ + minMargin
        ) {
          return false;
        }
      }

      // 3. Jangan menabrak bangunan rumah atau lingkaran Drop Zone warga
      for (const h of cfg.houses) {
        if (Math.hypot(x - h.x, z - h.z) < 9.5) return false;
        if (Math.hypot(x - h.dropX, z - h.dropZ) < 6.5) return false;
      }

      return true;
    }

    function createCitizenNPC(x, z, houseId) {
      const npc = new THREE.Group();

      const body = new THREE.Mesh(
        new THREE.CylinderGeometry(0.48, 0.6, 1.35, 12),
        new THREE.MeshLambertMaterial({ color: 0x0284c7 })
      );
      body.position.y = 0.7;
      body.castShadow = true;
      npc.add(body);

      const head = new THREE.Mesh(
        new THREE.SphereGeometry(0.45, 14, 14),
        new THREE.MeshLambertMaterial({ color: 0xfde68a })
      );
      head.position.y = 1.75;
      head.castShadow = true;
      npc.add(head);

      const arm = new THREE.Mesh(
        new THREE.CylinderGeometry(0.12, 0.12, 0.85, 8),
        new THREE.MeshLambertMaterial({ color: 0xfde68a })
      );
      arm.position.set(0.6, 1.25, 0);
      arm.rotation.z = -Math.PI / 3;
      npc.add(arm);

      // Floating Label Sprite di atas NPC
      const c = document.createElement('canvas');
      c.width = 256;
      c.height = 96;
      const ctx = c.getContext('2d');
      ctx.fillStyle = '#ea580c';
      ctx.beginPath();
      ctx.roundRect(8, 8, 240, 80, 18);
      ctx.fill();
      ctx.fillStyle = '#ffffff';
      ctx.font = 'bold 30px sans-serif';
      ctx.textAlign = 'center';
      ctx.fillText(`📦 #${houseId}`, 128, 58);

      const tex = new THREE.CanvasTexture(c);
      const sprite = new THREE.Sprite(new THREE.SpriteMaterial({ map: tex }));
      sprite.position.set(0, 3.3, 0);
      sprite.scale.set(3.2, 1.2, 1);
      sprite.visible = false;
      npc.add(sprite);

      npc.position.set(x, 0, z);
      worldGroup.add(npc);

      return { group: npc, arm, sprite, houseId };
    }

    function createPineTree(x, z, scale = 1) {
      const tree = new THREE.Group();
      const trunk = new THREE.Mesh(
        new THREE.CylinderGeometry(0.35 * scale, 0.55 * scale, 2.2 * scale, 8),
        new THREE.MeshLambertMaterial({ color: 0x6d4c41 })
      );
      trunk.position.y = 1.1 * scale;
      trunk.castShadow = true;
      tree.add(trunk);

      const tier1 = new THREE.Mesh(
        new THREE.ConeGeometry(2.1 * scale, 3.0 * scale, 8),
        new THREE.MeshLambertMaterial({ color: 0x2e7d32 })
      );
      tier1.position.y = 2.8 * scale;
      tier1.castShadow = true;
      tree.add(tier1);

      const tier2 = new THREE.Mesh(
        new THREE.ConeGeometry(1.6 * scale, 2.5 * scale, 8),
        new THREE.MeshLambertMaterial({ color: 0x388e3c })
      );
      tier2.position.y = 4.3 * scale;
      tier2.castShadow = true;
      tree.add(tier2);

      tree.position.set(x, 0, z);
      worldGroup.add(tree);
      addCircleCollider(x, z, 1.15 * scale);
    }

    function createOakTree(x, z, scale = 1, leafColor = 0x43a047) {
      const tree = new THREE.Group();
      const trunk = new THREE.Mesh(
        new THREE.CylinderGeometry(0.42 * scale, 0.65 * scale, 2.6 * scale, 8),
        new THREE.MeshLambertMaterial({ color: 0x5d4037 })
      );
      trunk.position.y = 1.3 * scale;
      trunk.castShadow = true;
      tree.add(trunk);

      const crown = new THREE.Mesh(
        new THREE.DodecahedronGeometry(2.2 * scale),
        new THREE.MeshLambertMaterial({ color: leafColor })
      );
      crown.position.y = 3.8 * scale;
      crown.castShadow = true;
      tree.add(crown);

      tree.position.set(x, 0, z);
      worldGroup.add(tree);
      addCircleCollider(x, z, 1.2 * scale);
    }

    function createRockCluster(x, z, scale = 1) {
      const rockGroup = new THREE.Group();
      const mainRock = new THREE.Mesh(
        new THREE.DodecahedronGeometry(1.35 * scale, 0),
        new THREE.MeshLambertMaterial({ color: 0x78909c })
      );
      mainRock.position.y = 0.7 * scale;
      mainRock.scale.set(1.2, 0.85, 1.0);
      mainRock.castShadow = true;
      rockGroup.add(mainRock);

      const subRock = new THREE.Mesh(
        new THREE.DodecahedronGeometry(0.8 * scale, 0),
        new THREE.MeshLambertMaterial({ color: 0x90a4ae })
      );
      subRock.position.set(1.0 * scale, 0.45 * scale, 0.4 * scale);
      subRock.castShadow = true;
      rockGroup.add(subRock);

      rockGroup.position.set(x, 0, z);
      worldGroup.add(rockGroup);
      addCircleCollider(x, z, 1.3 * scale);
    }

    function createCargoContainerProp(x, z, rotY = 0, color = 0x0284c7) {
      const cont = new THREE.Mesh(
        new THREE.BoxGeometry(6.8, 3.2, 3.0),
        new THREE.MeshLambertMaterial({ color })
      );
      cont.position.set(x, 1.6, z);
      cont.rotation.y = rotY;
      cont.castShadow = true;
      cont.receiveShadow = true;
      worldGroup.add(cont);
      addBoxCollider(x, z, rotY === 0 ? 7.0 : 3.2, rotY === 0 ? 3.2 : 7.0);
    }

    function createStreetLamp(x, z) {
      const lamp = new THREE.Group();
      const pole = new THREE.Mesh(
        new THREE.CylinderGeometry(0.12, 0.16, 4.8, 8),
        new THREE.MeshLambertMaterial({ color: 0x334155 })
      );
      pole.position.y = 2.4;
      pole.castShadow = true;
      lamp.add(pole);

      const bulb = new THREE.Mesh(
        new THREE.SphereGeometry(0.38, 10, 10),
        new THREE.MeshBasicMaterial({ color: 0xfef08a })
      );
      bulb.position.set(0, 4.9, 0);
      lamp.add(bulb);

      lamp.position.set(x, 0, z);
      worldGroup.add(lamp);
      addCircleCollider(x, z, 0.45);
    }

    function buildLevelMap(levelId) {
      while (worldGroup.children.length > 0) {
        worldGroup.remove(worldGroup.children[0]);
      }
      colliders = [];
      roadSegments = [];
      houses = [];
      npcs = [];

      const cfg = LEVEL_DATA[levelId] || LEVEL_DATA[1];
      scene.background.setHex(cfg.skyColor);
      scene.fog.color.setHex(cfg.skyColor);

      // Ground Rumput / Lantai Distrik
      const ground = new THREE.Mesh(
        new THREE.PlaneGeometry(240, 240),
        new THREE.MeshLambertMaterial({ color: cfg.groundColor })
      );
      ground.rotation.x = -Math.PI / 2;
      ground.receiveShadow = true;
      worldGroup.add(ground);

      // Bangun Segmen Jalan (Asphalt, Concrete, Dirt)
      cfg.roads.forEach(r => {
        const w = r.maxX - r.minX;
        const l = r.maxZ - r.minZ;
        const cx = (r.minX + r.maxX) / 2;
        const cz = (r.minZ + r.maxZ) / 2;

        let color = 0x272b30; // Aspal
        let yOffset = 0.025;
        if (r.type === 'concrete') {
          color = 0x94a3b8; // Beton
          yOffset = 0.02;
        } else if (r.type === 'dirt') {
          color = 0x855836; // Tanah
          yOffset = 0.015;
        }

        const roadMesh = new THREE.Mesh(
          new THREE.PlaneGeometry(w, l),
          new THREE.MeshLambertMaterial({ color })
        );
        roadMesh.rotation.x = -Math.PI / 2;
        roadMesh.position.set(cx, yOffset, cz);
        roadMesh.receiveShadow = true;
        worldGroup.add(roadMesh);

        roadSegments.push(r);

        // Marka Putih Khusus Aspal
        if (r.type === 'asphalt') {
          const isZ = l > w;
          const usableLen = (isZ ? l : w) - 10;
          const step = 8;
          const halfSpan = usableLen / 2;

          for (let offset = -halfSpan; offset <= halfSpan; offset += step) {
            const mark = new THREE.Mesh(
              new THREE.PlaneGeometry(isZ ? 0.45 : 3.0, isZ ? 3.0 : 0.45),
              new THREE.MeshBasicMaterial({ color: 0xf8fafc })
            );
            mark.rotation.x = -Math.PI / 2;
            mark.position.set(
              isZ ? cx : cx + offset,
              0.035,
              isZ ? cz + offset : cz
            );
            worldGroup.add(mark);
          }
        }
      });

      // Bangunan Warehouse Hub
      const whGroup = new THREE.Group();
      const whBody = new THREE.Mesh(
        new THREE.BoxGeometry(16, 8.5, 11),
        new THREE.MeshLambertMaterial({ color: 0x1e3a8a })
      );
      whBody.position.y = 4.25;
      whBody.castShadow = true;
      whBody.receiveShadow = true;
      whGroup.add(whBody);

      const whRoof = new THREE.Mesh(
        new THREE.ConeGeometry(12.5, 4.2, 4),
        new THREE.MeshLambertMaterial({ color: 0x172554 })
      );
      whRoof.position.y = 10.6;
      whRoof.rotation.y = Math.PI / 4;
      whRoof.scale.set(1.1, 0.9, 1.3);
      whRoof.castShadow = true;
      whGroup.add(whRoof);

      const whDoor = new THREE.Mesh(
        new THREE.PlaneGeometry(6, 5.5),
        new THREE.MeshLambertMaterial({ color: 0xf59e0b })
      );
      whDoor.position.set(0, 2.75, 5.52);
      whGroup.add(whDoor);

      whGroup.position.copy(warehouseBuildingPos);
      worldGroup.add(whGroup);
      addBoxCollider(warehouseBuildingPos.x, warehouseBuildingPos.z, 16.5, 11.5);

      // Lingkaran Kuning Loading Bay Gudang
      const bayRing = new THREE.Mesh(
        new THREE.RingGeometry(3.2, 4.4, 32),
        new THREE.MeshBasicMaterial({ color: 0xfacc15, side: THREE.DoubleSide })
      );
      bayRing.rotation.x = -Math.PI / 2;
      bayRing.position.set(warehouseBayPos.x, 0.04, warehouseBayPos.z);
      worldGroup.add(bayRing);

      // Bangun Rumah Warga + Drop Zone Ring + NPC
      cfg.houses.forEach(h => {
        const hGroup = new THREE.Group();
        const wall = new THREE.Mesh(
          new THREE.BoxGeometry(8, 5.5, 8),
          new THREE.MeshLambertMaterial({ color: 0xf8fafc })
        );
        wall.position.y = 2.75;
        wall.castShadow = true;
        wall.receiveShadow = true;
        hGroup.add(wall);

        const roof = new THREE.Mesh(
          new THREE.ConeGeometry(6.8, 3.6, 4),
          new THREE.MeshLambertMaterial({ color: h.color })
        );
        roof.position.y = 7.3;
        roof.rotation.y = Math.PI / 4;
        roof.castShadow = true;
        hGroup.add(roof);

        hGroup.position.set(h.x, 0, h.z);
        worldGroup.add(hGroup);
        addBoxCollider(h.x, h.z, 8.6, 8.6);

        const dropPos = new THREE.Vector3(h.dropX, 0.04, h.dropZ);
        const zoneRing = new THREE.Mesh(
          new THREE.RingGeometry(2.5, 3.5, 32),
          new THREE.MeshBasicMaterial({ color: 0x38bdf8, side: THREE.DoubleSide })
        );
        zoneRing.rotation.x = -Math.PI / 2;
        zoneRing.position.copy(dropPos);
        worldGroup.add(zoneRing);

        const npc = createCitizenNPC(h.dropX, h.dropZ, h.id);
        npcs.push(npc);

        houses.push({
          id: h.id,
          name: `Rumah #${h.id}`,
          dropPos,
          zoneRing,
          npc
        });
      });

      // Barikade Batas Jalan (Dijamin tidak pernah muncul di dekat titik Spawn!)
      cfg.barriers.forEach(b => {
        if (Math.hypot(b.x - SPAWN_POS.x, b.z - SPAWN_POS.z) < 14) return;
        const barGroup = new THREE.Group();
        const beam = new THREE.Mesh(
          new THREE.BoxGeometry(b.width, 1.3, 0.8),
          new THREE.MeshLambertMaterial({ color: 0xef4444 })
        );
        beam.position.y = 0.8;
        beam.castShadow = true;
        barGroup.add(beam);

        const stripe = new THREE.Mesh(
          new THREE.BoxGeometry(b.width * 0.9, 0.35, 0.85),
          new THREE.MeshBasicMaterial({ color: 0xfef08a })
        );
        stripe.position.y = 0.9;
        barGroup.add(stripe);

        barGroup.position.set(b.x, 0, b.z);
        barGroup.rotation.y = b.rot || 0;
        worldGroup.add(barGroup);
        addCircleCollider(b.x, b.z, 2.3);
      });

      // Traffic Cones di Bahu Jalan (Obstacle Ringan yang Masuk Akal)
      (cfg.cones || []).forEach(c => {
        if (Math.hypot(c.x - SPAWN_POS.x, c.z - SPAWN_POS.z) < 10) return;
        const cone = new THREE.Mesh(
          new THREE.ConeGeometry(0.55, 1.35, 10),
          new THREE.MeshLambertMaterial({ color: 0xf97316 })
        );
        cone.position.set(c.x, 0.68, c.z);
        cone.castShadow = true;
        worldGroup.add(cone);
        addCircleCollider(c.x, c.z, 0.65);
      });

      // Lampu Jalan di Sepanjang Jalan Utama
      [-36, -18, 18, 36].forEach(lx => {
        if (isSafePropPosition(lx, -5.5, cfg, 1.0)) createStreetLamp(lx, -5.5);
        if (isSafePropPosition(lx, 5.5, cfg, 1.0)) createStreetLamp(lx, 5.5);
      });

      // Generasi Pepohonan, Bebatuan, dan Kontainer Kargo yang Rapat & Bervariasi (Anti-Boring)
      const leafPalette = [0x2e7d32, 0x43a047, 0x66bb6a, 0xd97706, 0x15803d];
      const containerColors = [0x0284c7, 0xdc2626, 0xd97706, 0x059669, 0x4f46e5];

      // Seeded pseudo-random supaya tata letak prop konsisten namun alami
      let seed = levelId * 1337;
      const nextRand = () => {
        seed = (seed * 16807) % 2147483647;
        return (seed - 1) / 2147483646;
      };

      for (let i = 0; i < 95; i++) {
        const px = (nextRand() - 0.5) * 136;
        const pz = (nextRand() - 0.5) * 136;

        if (!isSafePropPosition(px, pz, cfg, 3.4)) continue;

        // Hindari menumpuk dengan prop yang sudah dipasang sebelumnya
        let tooClose = false;
        for (const col of colliders) {
          const cx = col.type === 'circle' ? col.x : (col.minX + col.maxX) / 2;
          const cz = col.type === 'circle' ? col.z : (col.minZ + col.maxZ) / 2;
          if (Math.hypot(px - cx, pz - cz) < 4.5) {
            tooClose = true;
            break;
          }
        }
        if (tooClose) continue;

        const roll = nextRand();
        const scale = 0.85 + nextRand() * 0.45;

        if (levelId === 3 && roll < 0.28) {
          // Di level Pelabuhan, perbanyak kontainer kargo industri
          const col = containerColors[Math.floor(nextRand() * containerColors.length)];
          createCargoContainerProp(px, pz, nextRand() > 0.5 ? 0 : Math.PI / 2, col);
        } else if (roll < 0.48) {
          createPineTree(px, pz, scale);
        } else if (roll < 0.82) {
          const lCol = leafPalette[Math.floor(nextRand() * leafPalette.length)];
          createOakTree(px, pz, scale, lCol);
        } else {
          createRockCluster(px, pz, scale);
        }
      }
    }

    /* =========================================================================
       6. MOBIL KURIR & PANAH NAVIGASI 3D SUPER JELAS (HIGH-VISIBILITY GPS CHEVRON)
       ========================================================================= */
    const courierGroup = new THREE.Group();

    const chassis = new THREE.Mesh(
      new THREE.BoxGeometry(2.7, 1.2, 4.3),
      new THREE.MeshLambertMaterial({ color: 0x0284c7 })
    );
    chassis.position.y = 1.05;
    chassis.castShadow = true;
    courierGroup.add(chassis);

    const cabin = new THREE.Mesh(
      new THREE.BoxGeometry(2.4, 1.3, 1.7),
      new THREE.MeshLambertMaterial({ color: 0x38bdf8 })
    );
    cabin.position.set(0, 2.0, 1.0);
    cabin.castShadow = true;
    courierGroup.add(cabin);

    const wGeo = new THREE.CylinderGeometry(0.52, 0.52, 0.4, 14);
    wGeo.rotateZ(Math.PI / 2);
    const wMat = new THREE.MeshLambertMaterial({ color: 0x0f172a });
    [[-1.4, 0.52, 1.3], [1.4, 0.52, 1.3], [-1.4, 0.52, -1.3], [1.4, 0.52, -1.3]].forEach(p => {
      const wheel = new THREE.Mesh(wGeo, wMat);
      wheel.position.set(p[0], p[1], p[2]);
      courierGroup.add(wheel);
    });

    const packageMeshes = [];
    for (let i = 0; i < 3; i++) {
      const box = new THREE.Mesh(
        new THREE.BoxGeometry(1.4, 0.8, 1.4),
        new THREE.MeshLambertMaterial({ color: 0xd97706 })
      );
      box.position.set(0, 1.8 + i * 0.85, -0.85);
      box.castShadow = true;
      box.visible = false;
      courierGroup.add(box);
      packageMeshes.push(box);
    }

    // Panah Navigasi GPS 3D Super Jelas (Cincin Kompas Gelap + Batang & Kepala Panah Kuning/Hijau Neon Besar)
    const navArrow = new THREE.Group();

    // Cincin Halo Hitam Kontras Tinggi agar Panah Terlihat Jelas di Atas Aspal, Beton, maupun Rumput
    const compassDisc = new THREE.Mesh(
      new THREE.CylinderGeometry(2.1, 2.1, 0.14, 24),
      new THREE.MeshBasicMaterial({ color: 0x0f172a, transparent: true, opacity: 0.82 })
    );
    navArrow.add(compassDisc);

    const compassRim = new THREE.Mesh(
      new THREE.RingGeometry(1.85, 2.18, 24),
      new THREE.MeshBasicMaterial({ color: 0xfef08a, side: THREE.DoubleSide })
    );
    compassRim.rotation.x = -Math.PI / 2;
    compassRim.position.y = 0.09;
    navArrow.add(compassRim);

    // Batang Panah (Shaft)
    const arrowShaft = new THREE.Mesh(
      new THREE.BoxGeometry(0.95, 0.35, 1.9),
      new THREE.MeshBasicMaterial({ color: 0xfacc15 })
    );
    arrowShaft.position.set(0, 0.25, -0.35);
    navArrow.add(arrowShaft);

    // Kepala Panah Lebar & Tegas (Arrowhead) menunjuk ke arah +Z lokal
    const arrowHead = new THREE.Mesh(
      new THREE.ConeGeometry(1.45, 2.2, 4),
      new THREE.MeshBasicMaterial({ color: 0x4ade80 })
    );
    arrowHead.rotation.x = Math.PI / 2;
    arrowHead.rotation.y = Math.PI / 4;
    arrowHead.scale.set(1.15, 1.0, 0.45);
    arrowHead.position.set(0, 0.28, 1.25);
    navArrow.add(arrowHead);

    navArrow.position.set(0, 5.6, 0);
    courierGroup.add(navArrow);

    scene.add(courierGroup);

    /* =========================================================================
       7. LOGIKA DETEKSI PERMUKAAN, TABRAKAN SOLID & PEMILIHAN RUMAH ANTI-DUPLIKAT
       ========================================================================= */
    function detectRoadSurface(x, z) {
      // Prioritas: Aspal > Beton > Tanah > Rumput
      let found = 'offroad';
      for (const r of roadSegments) {
        if (x >= r.minX && x <= r.maxX && z >= r.minZ && z <= r.maxZ) {
          if (r.type === 'asphalt') return 'asphalt';
          if (r.type === 'concrete') found = 'concrete';
          else if (r.type === 'dirt' && found === 'offroad') found = 'dirt';
        }
      }
      return found;
    }

    function checkCollisionAt(x, z) {
      const radius = 1.65;
      if (Math.abs(x) > 78 || Math.abs(z) > 78) return true;

      for (const c of colliders) {
        if (c.type === 'box') {
          const closestX = Math.max(c.minX, Math.min(x, c.maxX));
          const closestZ = Math.max(c.minZ, Math.min(z, c.maxZ));
          if (Math.hypot(x - closestX, z - closestZ) < radius) return true;
        } else if (c.type === 'circle') {
          if (Math.hypot(x - c.x, z - c.z) < radius + c.r) return true;
        }
      }
      return false;
    }

    function pickNextRandomHouse() {
      if (houses.length === 0) return;
      let pool = houses.filter(h => h.id !== state.lastDeliveredHouseId);
      if (pool.length === 0) pool = houses;

      const chosen = pool[Math.floor(Math.random() * pool.length)];
      state.targetHouse = chosen;
      state.objective = 'house';

      houses.forEach(h => {
        h.zoneRing.material.color.setHex(0x38bdf8);
        h.zoneRing.scale.set(1, 1, 1);
        if (h.npc) h.npc.sprite.visible = false;
      });

      chosen.zoneRing.material.color.setHex(0xf97316);
      chosen.zoneRing.scale.set(1.25, 1.25, 1.25);
      if (chosen.npc) chosen.npc.sprite.visible = true;

      document.getElementById('objective-text').innerText = `🚚 Antar paket ke ${chosen.name}! Ikuti panah hijau di atas mobil.`;
    }

    function refreshCargoUI() {
      document.getElementById('hud-cargo').innerText = `${state.packagesLoaded} / ${state.maxPackages}`;
      document.getElementById('quota-delivered').innerText = state.deliveredCount;
      document.getElementById('hud-cash').innerText = state.totalCash.toLocaleString('id-ID');

      packageMeshes.forEach((m, i) => {
        m.visible = i < state.packagesLoaded;
      });
    }

    function showToast(text) {
      const pill = document.getElementById('toast-pill');
      document.getElementById('toast-text').innerText = text;
      pill.classList.remove('opacity-0', '-translate-y-3', 'scale-95');
      pill.classList.add('opacity-100', 'translate-y-0', 'scale-100');
      clearTimeout(window._toastTimer);
      window._toastTimer = setTimeout(() => {
        pill.classList.add('opacity-0', '-translate-y-3', 'scale-95');
        pill.classList.remove('opacity-100', 'translate-y-0', 'scale-100');
      }, 2200);
    }

    /* =========================================================================
       8. VALIDASI INTERAKSI (TAHAN SPASI / TOMBOL LAYAR)
       ========================================================================= */
    const overlayEl = document.getElementById('interaction-overlay');
    const progressCircle = document.getElementById('progress-circle');
    const holdBtnLabel = document.getElementById('hold-btn-label');

    function handleZoneVerification(now) {
      const pos = courierGroup.position;
      let activeType = null;

      if (state.objective === 'warehouse') {
        if (pos.distanceTo(warehouseBayPos) < 5.0 && state.packagesLoaded < state.maxPackages) {
          activeType = 'warehouse';
          document.getElementById('action-subtext').innerText = 'Muat 3 Paket dari Gudang Hub';
          holdBtnLabel.innerText = 'MUAT';
        }
      } else if (state.objective === 'house' && state.targetHouse) {
        if (pos.distanceTo(state.targetHouse.dropPos) < 4.8 && state.packagesLoaded > 0) {
          activeType = 'house';
          document.getElementById('action-subtext').innerText = `Serahkan Paket ke ${state.targetHouse.name}`;
          holdBtnLabel.innerText = 'KIRIM';
        }
      }

      if (activeType) {
        overlayEl.classList.remove('opacity-0', 'translate-y-4', 'scale-95');
        overlayEl.classList.add('opacity-100', 'translate-y-0', 'scale-100');
      } else {
        overlayEl.classList.add('opacity-0', 'translate-y-4', 'scale-95');
        overlayEl.classList.remove('opacity-100', 'translate-y-0', 'scale-100');
        holdBtnLabel.innerText = 'TAHAN';
      }

      if (activeType && state.isHoldingVerify) {
        state.verifyProgress = Math.min(1.0, state.verifyProgress + 0.025);
        if (now - state.lastBeepTime > 90) {
          sound.playBeep(480 + state.verifyProgress * 520, 0.045, 'sine', 0.06);
          state.lastBeepTime = now;
        }

        if (state.verifyProgress >= 1.0) {
          state.verifyProgress = 0;
          state.isHoldingVerify = false;

          if (activeType === 'warehouse') {
            state.packagesLoaded = state.maxPackages;
            refreshCargoUI();
            sound.playSuccess();
            showToast('📦 3 Paket Berhasil Dimuat dari Gudang!');
            pickNextRandomHouse();
          } else if (activeType === 'house') {
            const deliveredName = state.targetHouse.name;
            state.lastDeliveredHouseId = state.targetHouse.id;
            state.packagesLoaded--;
            state.deliveredCount++;
            state.totalCash += 50000;
            refreshCargoUI();
            sound.playSuccess();
            showToast(`🎉 Paket Diterima di ${deliveredName}! +Rp 50.000`);

            if (state.deliveredCount >= state.quotaTarget) {
              onLevelCompleted();
              return;
            }

            if (state.packagesLoaded > 0) {
              pickNextRandomHouse();
            } else {
              state.objective = 'warehouse';
              state.targetHouse = null;
              houses.forEach(h => {
                h.zoneRing.material.color.setHex(0x38bdf8);
                if (h.npc) h.npc.sprite.visible = false;
              });
              document.getElementById('objective-text').innerText = '🔄 Muatan Habis! Kembali ke Lingkaran Kuning Gudang untuk isi ulang.';
            }
          }
        }
      } else {
        state.verifyProgress = Math.max(0, state.verifyProgress - 0.05);
      }

      const circumference = 138.23;
      progressCircle.style.strokeDashoffset = circumference - state.verifyProgress * circumference;
    }

    /* =========================================================================
       9. MANAJEMEN LEVEL & SHIFT TIMER
       ========================================================================= */
    const modalScreen = document.getElementById('modal-screen');
    const btnStartGame = document.getElementById('btn-start-game');

    function loadLevelSession(lvlId) {
      const cfg = LEVEL_DATA[lvlId] || LEVEL_DATA[1];
      state.level = lvlId;
      state.quotaTarget = cfg.quotaTarget;
      state.timeLeft = cfg.shiftDuration;
      state.deliveredCount = 0;
      state.packagesLoaded = 0;
      state.objective = 'warehouse';
      state.targetHouse = null;
      state.lastDeliveredHouseId = null;
      state.speed = 0;

      buildLevelMap(lvlId);
      // Spawn mobil di titik aman yang bebas dari barikade
      courierGroup.position.set(SPAWN_POS.x, 0, SPAWN_POS.z);
      courierGroup.rotation.y = Math.PI; // Menghadap langsung ke arah Loading Bay Gudang
      state.courierRot = Math.PI;
      refreshCargoUI();

      document.getElementById('hud-level-number').innerText = `L${lvlId}`;
      document.getElementById('hud-level-title').innerText = cfg.title;
      document.getElementById('quota-target').innerText = cfg.quotaTarget;
      document.getElementById('objective-text').innerText = '📦 Menuju Lingkaran Kuning Gudang untuk memuat 3 paket!';
    }

    function startLevelPlay() {
      sound.init();
      state.isPlaying = true;
      modalScreen.classList.add('hidden');
    }

    function onLevelCompleted() {
      state.isPlaying = false;
      if (state.level < 3) {
        const next = state.level + 1;
        const nextCfg = LEVEL_DATA[next];
        document.getElementById('modal-title').innerText = `DISTRIK LEVEL ${state.level} SELESAI!`;
        document.getElementById('modal-subtitle').innerText = `Seluruh kuota pengiriman terpenuhi! Bersiap memasuki ${nextCfg.fullName}.`;
        document.getElementById('stat-level-text').innerText = `Level ${next}`;
        document.getElementById('stat-quota-badge').innerText = `Target: ${nextCfg.quotaTarget} Paket`;
        document.getElementById('stat-theme').innerText = nextCfg.themeDesc;
        document.getElementById('stat-salary').innerText = `Rp ${state.totalCash.toLocaleString('id-ID')}`;
        document.getElementById('btn-start-label').innerText = `LANJUT KE LEVEL ${next}`;

        btnStartGame.onclick = () => {
          loadLevelSession(next);
          startLevelPlay();
        };
        modalScreen.classList.remove('hidden');
      } else {
        document.getElementById('modal-title').innerText = '🏆 MASTER COURIER TAMAT!';
        document.getElementById('modal-subtitle').innerText = 'Selamat! Seluruh 3 distrik kota telah berhasil Anda layani dengan sempurna!';
        document.getElementById('stat-level-text').innerText = 'Selesai (L3)';
        document.getElementById('stat-salary').innerText = `Rp ${state.totalCash.toLocaleString('id-ID')}`;
        document.getElementById('btn-start-label').innerText = 'MAIN LAGI DARI LEVEL 1';

        btnStartGame.onclick = () => {
          state.totalCash = 0;
          loadLevelSession(1);
          startLevelPlay();
        };
        modalScreen.classList.remove('hidden');
      }
    }

    setInterval(() => {
      if (!state.isPlaying) return;
      state.timeLeft = Math.max(0, state.timeLeft - 1);
      const m = String(Math.floor(state.timeLeft / 60)).padStart(2, '0');
      const s = String(state.timeLeft % 60).padStart(2, '0');
      document.getElementById('shift-timer').innerText = `${m}:${s}`;

      if (state.timeLeft <= 0) {
        state.isPlaying = false;
        document.getElementById('modal-title').innerText = '⏰ WAKTU SHIFT HABIS!';
        document.getElementById('modal-subtitle').innerText = 'Kuota pengiriman belum selesai. Gunakan jalan aspal dan beton agar laju mobil lebih cepat!';
        document.getElementById('btn-start-label').innerText = `ULANGI LEVEL ${state.level}`;
        btnStartGame.onclick = () => {
          loadLevelSession(state.level);
          startLevelPlay();
        };
        modalScreen.classList.remove('hidden');
      }
    }, 1000);

    /* =========================================================================
       10. KONTROL KEYBOARD, TOUCH JOYSTICK & TOMBOL VERIFIKASI
       ========================================================================= */
    window.addEventListener('keydown', (e) => {
      sound.init();
      const k = e.key.toLowerCase();
      if (k === 'w' || k === 'arrowup') keys.w = true;
      if (k === 's' || k === 'arrowdown') keys.s = true;
      if (k === 'a' || k === 'arrowleft') keys.a = true;
      if (k === 'd' || k === 'arrowright') keys.d = true;
      if (k === ' ') state.isHoldingVerify = true;
    });

    window.addEventListener('keyup', (e) => {
      const k = e.key.toLowerCase();
      if (k === 'w' || k === 'arrowup') keys.w = false;
      if (k === 's' || k === 'arrowdown') keys.s = false;
      if (k === 'a' || k === 'arrowleft') keys.a = false;
      if (k === 'd' || k === 'arrowright') keys.d = false;
      if (k === ' ') state.isHoldingVerify = false;
    });

    const holdBtn = document.getElementById('hold-verify-btn');
    const cardBtn = document.getElementById('interaction-card-btn');
    [holdBtn, cardBtn].forEach(el => {
      el.addEventListener('pointerdown', (e) => {
        e.preventDefault();
        sound.init();
        state.isHoldingVerify = true;
      });
    });
    window.addEventListener('pointerup', () => {
      state.isHoldingVerify = false;
    });

    const joyZone = document.getElementById('joystick-zone');
    const joyKnob = document.getElementById('joystick-knob');
    let joyOrigin = null;

    joyZone.addEventListener('touchstart', (e) => {
      sound.init();
      const t = e.touches[0];
      const r = joyZone.getBoundingClientRect();
      joyOrigin = { x: r.left + r.width / 2, y: r.top + r.height / 2 };
    }, { passive: false });

    joyZone.addEventListener('touchmove', (e) => {
      if (!joyOrigin) return;
      e.preventDefault();
      const t = e.touches[0];
      const dx = t.clientX - joyOrigin.x;
      const dy = t.clientY - joyOrigin.y;
      const dist = Math.min(40, Math.hypot(dx, dy));
      const ang = Math.atan2(dy, dx);
      joyKnob.style.transform = `translate(calc(-50% + ${Math.cos(ang) * dist}px), calc(-50% + ${Math.sin(ang) * dist}px))`;
      joyVec.x = (Math.cos(ang) * dist) / 40;
      joyVec.y = (Math.sin(ang) * dist) / 40;
    }, { passive: false });

    const resetJoy = () => {
      joyOrigin = null;
      joyVec = { x: 0, y: 0 };
      joyKnob.style.transform = 'translate(-50%, -50%)';
    };
    joyZone.addEventListener('touchend', resetJoy);
    joyZone.addEventListener('touchcancel', resetJoy);

    /* =========================================================================
       11. MAIN GAME LOOP
       ========================================================================= */
    const surfLabelEl = document.getElementById('surface-label');
    const surfIconEl = document.getElementById('surface-icon');
    const surfBoxEl = document.getElementById('surface-icon-box');

    function animate(now) {
      requestAnimationFrame(animate);

      if (state.isPlaying) {
        // 1. Cek Permukaan Jalan
        const surfKey = detectRoadSurface(courierGroup.position.x, courierGroup.position.z);
        const surfInfo = SURFACE_TYPES[surfKey];

        surfLabelEl.innerText = surfInfo.label;
        surfLabelEl.className = `text-xs font-black ${surfInfo.colorClass}`;
        surfIconEl.className = `fa-solid ${surfInfo.icon} text-xs`;
        surfBoxEl.className = `w-8 h-8 rounded-xl flex items-center justify-center transition-colors ${surfInfo.boxClass}`;

        // 2. Pergerakan & Rotasi Mobil
        let mx = 0, mz = 0;
        if (keys.w) mz -= 1;
        if (keys.s) mz += 1;
        if (keys.a) mx -= 1;
        if (keys.d) mx += 1;
        if (joyVec.x !== 0 || joyVec.y !== 0) {
          mx = joyVec.x;
          mz = joyVec.y;
        }

        if (Math.hypot(mx, mz) > 0.1) {
          state.speed = Math.min(surfInfo.maxSpeed, state.speed + 0.035);
          state.courierRot = Math.atan2(mx, mz);
          courierGroup.rotation.y = state.courierRot;
        } else {
          state.speed = Math.max(0, state.speed - 0.045);
        }

        sound.updateEngine(state.speed / SURFACE_TYPES.asphalt.maxSpeed);

        // 3. Resolusi Tabrakan dengan Sliding Halus
        if (state.speed > 0.001) {
          const stepX = Math.sin(state.courierRot) * state.speed;
          const stepZ = Math.cos(state.courierRot) * state.speed;

          if (!checkCollisionAt(courierGroup.position.x + stepX, courierGroup.position.z)) {
            courierGroup.position.x += stepX;
          }
          if (!checkCollisionAt(courierGroup.position.x, courierGroup.position.z + stepZ)) {
            courierGroup.position.z += stepZ;
          }
        }

        // 4. Animasi Guncangan Kardus Kargo di Atas Mobil
        packageMeshes.forEach((box, idx) => {
          if (box.visible) {
            box.rotation.z = Math.sin(now * 0.016 + idx) * (state.speed * 0.14);
            box.rotation.x = Math.cos(now * 0.016 + idx) * (state.speed * 0.12);
          }
        });

        // 5. Panah Navigasi 3D & Pilar Cahaya Tujuan (Sky Beacon)
        const targetPos = (state.objective === 'house' && state.targetHouse)
          ? state.targetHouse.dropPos
          : warehouseBayPos;

        const isHouseObjective = state.objective === 'house';
        arrowHead.material.color.setHex(isHouseObjective ? 0x4ade80 : 0xfacc15);
        compassRim.material.color.setHex(isHouseObjective ? 0x4ade80 : 0xfacc15);

        beaconGroup.position.set(targetPos.x, 0, targetPos.z);
        beaconBeam.material.color.setHex(isHouseObjective ? 0xf97316 : 0xfacc15);
        beaconDiamond.material.color.setHex(isHouseObjective ? 0xfed7aa : 0xfef08a);
        beaconDiamond.rotation.y = now * 0.004;
        beaconDiamond.position.y = 6.2 + Math.sin(now * 0.006) * 0.7;

        const dx = targetPos.x - courierGroup.position.x;
        const dz = targetPos.z - courierGroup.position.z;
        navArrow.rotation.y = Math.atan2(dx, dz) - courierGroup.rotation.y;
        navArrow.position.y = 5.6 + Math.sin(now * 0.007) * 0.32;

        // 6. Animasi NPC Melambai & Melompat
        npcs.forEach(n => {
          const isTarget = state.objective === 'house' && state.targetHouse && state.targetHouse.id === n.houseId;
          if (isTarget) {
            n.arm.rotation.z = -Math.PI / 3 + Math.sin(now * 0.012) * 0.65;
            n.group.position.y = Math.abs(Math.sin(now * 0.008)) * 0.4;
          } else {
            n.arm.rotation.z = -Math.PI / 3;
            n.group.position.y = 0;
          }
        });

        handleZoneVerification(now);
      }

      // Kamera Isometrik Mengikuti Mobil
      camera.position.x = courierGroup.position.x + 46;
      camera.position.z = courierGroup.position.z + 46;
      camera.lookAt(courierGroup.position.x, 0, courierGroup.position.z);

      renderer.render(scene, camera);
    }

    window.addEventListener('resize', () => {
      const a = window.innerWidth / window.innerHeight;
      camera.left = -viewSize * a;
      camera.right = viewSize * a;
      camera.top = viewSize;
      camera.bottom = -viewSize;
      camera.updateProjectionMatrix();
      renderer.setSize(window.innerWidth, window.innerHeight);
    });

    const goModal = document.getElementById('go-modal');
    document.getElementById('btn-open-go').addEventListener('click', () => goModal.classList.remove('hidden'));
    document.getElementById('btn-close-go').addEventListener('click', () => goModal.classList.add('hidden'));
    goModal.addEventListener('click', (e) => {
      if (e.target === goModal) goModal.classList.add('hidden');
    });

    window.onload = () => {
      loadLevelSession(1);
      btnStartGame.onclick = startLevelPlay;
      animate(performance.now());
    };
  </script>
</body>
</html>